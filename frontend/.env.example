# Публичный адрес API. Используется, когда демо-режим выключен.
VITE_API_URL=http://localhost:8000/api/v1

# true  — приложение работает на встроенных демо-данных, бэкенд не нужен.
# false — все запросы уходят на VITE_API_URL.
VITE_USE_MOCK_API=true

# Важно: переменные VITE_* попадают в клиентский бандл.
# Никаких ключей, токенов и доступов к базе данных здесь быть не должно.
