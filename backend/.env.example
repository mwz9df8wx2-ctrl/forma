# Порт HTTP-сервера
PORT=8787

# Файл базы данных
DATABASE_FILE=./data/forma.db

# Каталог для загруженных файлов. Файлы отдаются только через API,
# публичных ссылок нет.
STORAGE_DIR=./data/files

# Секрет для подписи сессий. В продакшене обязательно свой.
SESSION_SECRET=change-me-in-production

# Ключ провайдера генерации изображений. Живёт ТОЛЬКО здесь,
# во фронтенд не передаётся ни при каких условиях.
OPENAI_API_KEY=

# Ключ Anthropic для разбора фотографии и парсинга требований.
ANTHROPIC_API_KEY=

# Глобальный выключатель генерации (§64 техзадания).
AI_GENERATION_ENABLED=true
